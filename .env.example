# Supabase Client Configuration (Public variables exposed to browser)
# Get these from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT SECURITY WARNING:
# NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend .env or client code!
# The service role key bypasses Row Level Security (RLS) and must only be used in secure backend / Edge Functions.

# App Configuration
VITE_APP_NAME="ApexFit Gym"
VITE_APP_ENV=development
